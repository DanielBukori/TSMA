{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "tsma-backend": {
      "root": "tsma-backend",
      "framework": "django"
    },
    "tsma-frontend": {
      "root": "tsma-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "tsma-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "tsma-frontend" }
    }
  ]
}
