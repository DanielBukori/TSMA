# ============================================================================
# TSMA Backend — .env.example
# Nakili faili hii kuwa ".env" (SIYO .env.example) na jaza thamani HALISI.
# KAMWE usiweke ".env" halisi kwenye Git — iko kwenye .gitignore tayari.
# ============================================================================

# ---- Core ----
DJANGO_SECRET_KEY=badilisha-hii-na-random-key-ndefu-sana-angalau-herufi-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=api.tsma.or.tz,localhost,127.0.0.1
FRONTEND_URL=https://tsma.or.tz

# ---- Database ----
DATABASE_URL=sqlite:///db.sqlite3 #postgres://tsma_user:CHANGE_ME@localhost:5432/tsma_db

# ---- CORS/CSRF (domain za frontend zinazoruhusiwa kuita API) ----
CORS_ALLOWED_ORIGINS=https://tsma.or.tz,https://www.tsma.or.tz
CSRF_TRUSTED_ORIGINS=https://tsma.or.tz,https://www.tsma.or.tz

# ---- Email (SMTP - production) ----
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@tsma.or.tz
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@tsma.or.tz

# ---- Gateways zinazoruhusiwa (Render -> Environment) ----
# DEFAULT = manual (benki + WhatsApp). Ukishapata funguo halisi, ongeza:
# ENABLED_PAYMENT_GATEWAYS=manual,selcom
ENABLED_PAYMENT_GATEWAYS=manual

# ---- Selcom Payment Gateway ----
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_VENDOR_ID=CHANGE_ME
SELCOM_API_KEY=CHANGE_ME
SELCOM_API_SECRET=CHANGE_ME
SELCOM_WEBHOOK_URL=https://api.tsma.or.tz/api/payments/webhook/selcom/

# ---- Teaching Excellence (Zoom - hiari, "manual" ni default salama) ----
TEACHING_MEETING_PROVIDER=manual
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Email Verification Enforcement (hiari) ----
REQUIRE_EMAIL_VERIFICATION=False

# ---- Sentry (Error Monitoring - hiari, acha wazi kuzima) ----
SENTRY_DSN=

# ---- AWS S3 (hiari - kwa private storage ya paid publications) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1

# ---- Security Monitoring Dashboard (self-healing + 2FA) ----
# WEKA key TOFAUTI KABISA na DJANGO_SECRET_KEY (random, ndefu) —
# usalama wa dashibodi ya security haupaswi kutegemea key ile ile
# inayotumika kwa akaunti za kawaida za TSMA.
SECURITY_ADMIN_SECRET_KEY=badilisha-hii-na-key-nyingine-tofauti-kabisa-na-ile-ya-juu
SECURITY_NOTIFICATION_CHANNELS=email
SECURITY_ALERT_RECIPIENTS=admin@tsma.or.tz,security@tsma.or.tz

# ---- Africa's Talking (hiari - SMS alerts) ----
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
