# /srv/tsma/tsma-backend/.env  (chmod 600, mmiliki: tsma)  - USIWEKE kwenye GitHub
DJANGO_DEBUG=False
# Tengeneza mpya: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=BADILISHA_HAPA
DJANGO_ALLOWED_HOSTS=tsma.or.tz,www.tsma.or.tz
FRONTEND_URL=https://tsma.or.tz
CORS_ALLOWED_ORIGINS=https://tsma.or.tz
CSRF_TRUSTED_ORIGINS=https://tsma.or.tz

# Postgres ya ndani ya server (badilisha PASSWORD)
DATABASE_URL=postgres://tsma:PASSWORD@127.0.0.1:5432/tsma
DB_POOLER=False

# Malipo: Manual pekee kwa sasa
ENABLED_PAYMENT_GATEWAYS=manual

# CLOUDINARY: ACHA TUPU / USIWEKE kabisa -> faili zinahifadhiwa kwenye disk ya server
# CLOUDINARY_URL=

# Barua pepe (SMTP) - tumia ya Sakurahost au nyingine
EMAIL_HOST=mail.tsma.or.tz
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@tsma.or.tz
EMAIL_HOST_PASSWORD=BADILISHA_HAPA
DEFAULT_FROM_EMAIL=noreply@tsma.or.tz

# Kama ulikuwa unatumia kwenye Render, nakili thamani zilezile:
# SECURITY_ADMIN_SECRET_KEY=
# SENTRY_DSN=
