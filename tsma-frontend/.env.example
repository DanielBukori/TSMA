# Nakili faili hii kuwa .env na weka thamani sahihi
VITE_API_BASE_URL=http://localhost:8000/api

# HAKUNA VITE_PAYMENT_GATEWAY inayohitajika tena — mtumiaji anachagua
# gateway moja kwa moja kwenye fomu (orodha inapakuliwa kutoka
# /api/payments/gateways/). Ili "manual" (testing bila Selcom) ionekane
# kama chaguo, hakikisha imesajiliwa kwenye backend
# payments/gateways/registry.py (tayari ipo, angalia TESTING_NA_GATEWAYS.md).

# Muundo wa tovuti: true = ukurasa mmoja mrefu (default), false = kurasa tofauti (/about, /news...)
# Badilisha kwenye Vercel -> Settings -> Environment Variables, kisha Redeploy.
VITE_SINGLE_PAGE=true
